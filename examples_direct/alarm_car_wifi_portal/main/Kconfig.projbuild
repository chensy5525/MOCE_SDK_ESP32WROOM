menu "Alarm car Wi-Fi portal"

config ALARM_CAR_PORTAL_AP_SSID
    string "SoftAP SSID"
    default "MOCE-AlarmCar"

config ALARM_CAR_PORTAL_AP_PASSWORD
    string "SoftAP password (8-63 characters)"
    default "mocemoce"

config ALARM_CAR_PORTAL_MAX_CONNECTIONS
    int "Maximum SoftAP stations"
    range 1 4
    default 4

config ALARM_CAR_STA_SSID
    string "Upstream Wi-Fi SSID (empty disables SNTP)"
    default ""

config ALARM_CAR_STA_PASSWORD
    string "Upstream Wi-Fi password (not logged)"
    default ""

config ALARM_CAR_STA_MAXIMUM_RETRIES
    int "Station retries per connection round"
    range 1 20
    default 5

config ALARM_CAR_STA_IP_WAIT_TIMEOUT_MS
    int "Station IP wait timeout (ms)"
    range 1000 120000
    default 15000

config ALARM_CAR_SNTP_SERVER
    string "SNTP server"
    default "pool.ntp.org"

config ALARM_CAR_SNTP_SYNC_TIMEOUT_MS
    int "SNTP first-sync timeout (ms)"
    range 1000 120000
    default 15000

config ALARM_CAR_SNTP_RETRY_INTERVAL_MS
    int "SNTP retry interval (ms)"
    range 1000 600000
    default 30000

config ALARM_CAR_SNTP_CALIBRATION_PERIOD_SECONDS
    int "Successful SNTP calibration period (seconds)"
    range 60 86400
    default 21600

config ALARM_CAR_UTC_OFFSET_MINUTES
    int "Local offset from UTC (minutes)"
    range -720 840
    default 480

config ALARM_CAR_NETWORK_TIME_TASK_STACK_SIZE
    int "Network time task stack size"
    range 3072 8192
    default 4096

config ALARM_CAR_SCHEDULER_TASK_STACK_SIZE
    int "Alarm scheduler task stack size"
    range 3072 8192
    default 4096

endmenu
